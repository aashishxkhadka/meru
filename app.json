{
  "expo": {
    "name": "Meru",
    "slug": "meru",
    "scheme": "meru",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.obsyd.meru",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Meru uses the camera to show peak names on top of the mountains you are looking at."
      }
    },
    "android": {
      "package": "com.obsyd.meru",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b1220"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Meru uses your location to work out which peaks you can see. It works offline and your location never leaves your phone."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Meru uses motion sensors to know where your phone is pointing."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Meru saves your labelled mountain photos to your gallery.",
          "savePhotosPermission": "Meru saves your labelled mountain photos to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-dev-client"
    ],
    "backgroundColor": "#0b1220"
  }
}
